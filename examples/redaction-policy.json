{
  "enabled": true,
  "replacement": "[REDACTED]",
  "sensitive_keys": [
    "access_token",
    "api_key",
    "authorization",
    "client_secret",
    "cookie",
    "password",
    "private_key",
    "refresh_token",
    "secret",
    "token"
  ],
  "value_patterns": [
    "(?i)\\bBearer\\s+[A-Za-z0-9._~+/=-]{12,}",
    "\\bsk-[A-Za-z0-9_-]{16,}\\b",
    "\\bgh[opusr]_[A-Za-z0-9]{20,}\\b",
    "\\bAKIA[0-9A-Z]{16}\\b"
  ]
}
